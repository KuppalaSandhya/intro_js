function areEqual(a1, a2) {
  return typeof a1 === typeof a2 ? numberLength(a1, a2) : false;
}

function numberLength(a1, a2) {
  return a1.length === a2.length ? numberEqual(a1, a2) : false;
}

function numberEqual(a1, a2) {
  for (let i = 0; i < a1.length; i++) {
    if ((typeof a1[i] === "object" && typeof a2[i]) === "object")
      return areEqual(a1[i], a2[i]);

    if (a1[i] !== a2[i]) return false;
  }
  return true;
}

console.log(areEqual([1, 2, 3, 4], [1, 2, 3, 4])); //true
console.log(areEqual([1, 2, 3], [1, 2, 3, 4])); //false
console.log(areEqual([1, 2, 3], [1, 3, 2])); //false
console.log(areEqual([1, [22, 3], 3], [1, [22, 3], 3])); //true
