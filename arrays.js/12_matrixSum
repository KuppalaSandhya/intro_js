console.log(
  sumMatrix([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9],
  ]),
); //=> 45

function sumMatrix(matrix) {
  let sum = 0;

  for (row = 0; row < matrix.length; row++) {
    for (column = 0; column < matrix[row].length; column++) {
      sum = sum + matrix[row][column];
    }
  }
  return sum;
}
