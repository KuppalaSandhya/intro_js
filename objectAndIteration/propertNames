const prices = {
  apple: 20,
  banana: 10,
  orange: 15,
  mango: 40,
};
let expensiveFruit = 0;
let expensiveItemCost = 0;
for (const [fruits, price] of Object.entries(prices)) {
  if (expensiveItemCost < price) {
    expensiveItemCost = price;
    expensiveFruit = fruits;
  }
}
console.log(expensiveFruit, expensiveItemCost);

